# PC B의 사설 LAN IPv4로 바꿉니다. PC B perf-b.env의 PERF_BIND_IP와 같아야 합니다.
PERF_TARGET_IP=192.168.50.12
PERF_API_PORT=18080
PERF_MANAGEMENT_PORT=18081
PERF_MYSQL_METRICS_PORT=19104

# Windows exporter 기본 포트는 9182, Linux node_exporter 기본 포트는 9100입니다.
PERF_HOST_A_TARGET=host.docker.internal:9182
PERF_HOST_B_TARGET=192.168.50.12:9182

# PC A에서 브라우저 및 로컬 CLI가 접속할 루프백 포트입니다.
PERF_PROMETHEUS_PORT=19090
PERF_GRAFANA_PORT=13000

# 환경 비교용 식별자. 실제 장비·리소스·네트워크가 달라지면 값을 갱신합니다.
PERF_ENVIRONMENT_LABEL=lan
PERF_HOST_A_PROFILE=pc-a-default
PERF_HOST_B_PROFILE=pc-b-default
PERF_NETWORK_PROFILE=wired-lan
