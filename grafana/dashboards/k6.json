{
  "title": "Matchuri · k6",
  "uid": "matchuri-k6",
  "tags": [
    "matchuri",
    "perf"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "perf"
      ],
      "title": "Matchuri perf dashboards",
      "type": "dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "definition": "label_values(k6_perf_started_total, run_id)",
        "hide": 0,
        "includeAll": false,
        "label": "Stage run ID",
        "multi": false,
        "name": "run_id",
        "options": [],
        "query": {
          "query": "label_values(k6_perf_started_total, run_id)",
          "refId": "runId"
        },
        "refresh": 2,
        "regex": "",
        "sort": 2,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP arrivals and completions",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "description": "Rates use Prometheus sample windows. Use the saved stage summary for exact measurement-window counts.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_perf_target_rate{run_id=\"$run_id\",phase=\"measurement\",kind!=\"sse\"})",
          "legendFormat": "Target"
        },
        {
          "refId": "B",
          "expr": "sum(rate(k6_perf_started_total{run_id=\"$run_id\",phase=\"measurement\",kind!=\"sse\"}[$__rate_interval]))",
          "legendFormat": "Started"
        },
        {
          "refId": "C",
          "expr": "sum(rate(k6_perf_completed_in_window_total{run_id=\"$run_id\",phase=\"measurement\",kind!=\"sse\"}[$__rate_interval]))",
          "legendFormat": "Completed"
        },
        {
          "refId": "D",
          "expr": "sum(rate(k6_perf_success_in_window_total{run_id=\"$run_id\",phase=\"measurement\",kind!=\"sse\"}[$__rate_interval]))",
          "legendFormat": "Succeeded"
        },
        {
          "refId": "E",
          "expr": "sum(rate(k6_dropped_iterations_total{run_id=\"$run_id\",scenario=\"measurement\",kind!=\"sse\"}[$__rate_interval]))",
          "legendFormat": "Dropped"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP latency",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "description": "Percentiles are calculated from native histograms within each time window.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(k6_perf_http_duration_seconds{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(k6_perf_http_duration_seconds{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(k6_perf_http_duration_seconds{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Unexpected error fraction",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "description": "Expected failure cases are tracked by their contract checks. Missing samples remain blank.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_perf_failed_total{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval])) / sum(rate(k6_perf_completed_total{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval]))",
          "legendFormat": "Unexpected failures"
        },
        {
          "refId": "B",
          "expr": "sum(rate(k6_perf_server_error_total{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval])) / sum(rate(k6_perf_completed_total{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval]))",
          "legendFormat": "Server errors or timeouts"
        }
      ]
    },
    {
      "id": 4,
      "title": "Virtual users",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_vus{run_id=\"$run_id\"})",
          "legendFormat": "Active VUs"
        },
        {
          "refId": "B",
          "expr": "max(k6_vus_max{run_id=\"$run_id\"})",
          "legendFormat": "VU cap"
        }
      ]
    },
    {
      "id": 5,
      "title": "SSE connections",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "description": "Active measurement connections are estimated by subtracting closes from successful opens.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_perf_target_rate{run_id=\"$run_id\",phase=\"measurement\",kind=\"sse\"})",
          "legendFormat": "Connection target / sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(k6_perf_sse_connected_total{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval]))",
          "legendFormat": "Connections / sec"
        },
        {
          "refId": "C",
          "expr": "clamp_min(sum(k6_perf_sse_connected_total{run_id=\"$run_id\",phase=\"measurement\"}) - (sum(k6_perf_sse_closed_total{run_id=\"$run_id\",phase=\"measurement\"}) or vector(0)), 0)",
          "legendFormat": "Active"
        },
        {
          "refId": "D",
          "expr": "sum(rate(k6_dropped_iterations_total{run_id=\"$run_id\",scenario=\"measurement\",kind=\"sse\"}[$__rate_interval]))",
          "legendFormat": "Dropped / sec"
        }
      ]
    },
    {
      "id": 6,
      "title": "SSE first event",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(k6_perf_sse_first_event_seconds{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(k6_perf_sse_first_event_seconds{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(k6_perf_sse_first_event_seconds{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "title": "SSE heartbeat and disconnects",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_perf_sse_heartbeat_total{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval]))",
          "legendFormat": "Heartbeat"
        },
        {
          "refId": "B",
          "expr": "sum(rate(k6_perf_sse_unexpected_disconnect_total{run_id=\"$run_id\",phase=\"measurement\"}[$__rate_interval]))",
          "legendFormat": "Unexpected disconnect"
        }
      ]
    }
  ]
}
